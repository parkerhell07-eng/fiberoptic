# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# Capacitor / Android build outputs
/.next-cap/
/public/fiberkar-*.apk
/download/*.apk
/download/*.idsig
/android/app/src/main/assets/public/
# Keystore files must NEVER be committed (raw)
*.keystore
*.jks
# BUT the AES-256-encrypted backup of the release keystore IS committed on purpose,
# so a sandbox reset can never lose the signing key again. Decryption password is
# kept offline by the project owner (NOT anywhere in this repository).
!keystore/fiberkar-release.keystore.enc
*.idsig
tool-results/
